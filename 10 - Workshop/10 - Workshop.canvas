      "color": "#0891b2"
    },
    {
      "id": "t018",
      "type": "text",
      "text": "**FW-02 production driver, RTC gate, UX**\nimplemented, never run on a device",
      "x": -370,
      "y": -110,
      "width": 640,
      "height": 72,
      "color": "#0891b2"
    },
    {
      "id": "t019",
      "type": "text",
      "text": "**FW-03 journal + replay**\nimplemented, power-loss behaviour unverified",
      "x": -370,
      "y": -32,
      "width": 640,
      "height": 72,
      "color": "#0891b2"
    },
    {
      "id": "t020",
      "type": "text",
      "text": "**FW-04 bearer-authenticated API client**\nimplemented, never talked to a server",
      "x": -370,
      "y": 46,
