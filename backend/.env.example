# Copy to .env locally; replace blank credentials. Never commit .env.
DATABASE_PATH=data/attendance.db
APP_TIMEZONE=Asia/Kolkata
MAX_CLOCK_SKEW_SECONDS=300
ADMIN_USERNAME=
ADMIN_PASSWORD=
GEMINI_API_KEY=
# Comma-separated browser origins allowed to call the API (LAN web use).
# Empty = same-origin only. Example (example only, do not copy blindly):
# ALLOWED_ORIGINS=http://192.168.1.50:8000
ALLOWED_ORIGINS=
