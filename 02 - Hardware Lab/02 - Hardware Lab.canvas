    },
    {
      "id": "t008",
      "type": "text",
      "text": "**ESP32-WROOM-32 DevKit**  ·  [owner-report]\nupload + USB serial work (owner report)\nport is now **COM4**",
      "x": -70,
      "y": -1180,
      "width": 540,
      "height": 120,
      "color": "#c2410c"
    },
    {
      "id": "t009",
      "type": "text",
      "text": "**R307S fingerprint sensor**  ·  [UNVERIFIED]\nassembled per owner report\n**0 valid bytes** · rail/logic UNVERIFIED",
      "x": 510,
      "y": -1180,
      "width": 540,
      "height": 120,
      "color": "#c2410c"
    },
    {
      "id": "t010",
      "type": "text",
      "text": "**SSD1306 OLED 128×64 — REMOVED**  ·  [not in this project]\nI2C 0x3C · GPIO21/22 (not connected)\nnot in this project",
      "x": -70,
      "y": -1045,
      "width": 540,
      "height": 120,
      "color": "#c2410c"
    },
    {
      "id": "t011",
      "type": "text",
      "text": "**DS3231 RTC**  ·  [not in this project]\nI2C 0x68 · GPIO21/22\nnot in this project",
      "x": 510,
      "y": -1045,
