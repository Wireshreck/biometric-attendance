{
  "expo": {
    "name": "Biometric Attendance",
    "slug": "biometric-attendance",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": { "backgroundColor": "#101828" },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.biometricattendance.app",
      "versionCode": 1,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 24 } }
      ]
    ]
  }
}
