# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
backend/.venv/
.venv/
venv/
ENV/
env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Secrets / Environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.h
secrets.ini
credentials.json
firmware/include/local_config.h
*.pem
*.key
*.pfx

# ─── PlatformIO ───────────────────────────────────────────────────────────────
**/.pio/

# ─── Arduino IDE ──────────────────────────────────────────────────────────────
*.ino.bin
*.ino.elf
*.ino.hex

# ─── Node.js (if ever used for frontend tooling) ──────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.npm

# ─── SQLite databases ─────────────────────────────────────────────────────────
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.db-journal
# Keep the data directory but not database files themselves
!backend/data/.gitkeep

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ─── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Obsidian internal workspace state ────────────────────────────────────────
# The repository root is the Obsidian vault. Keep this machine-specific UI/workspace config local.
/.obsidian/
# Keep any actual nested vault notes/canvas tracked; ignore only its window layout.
obsidian/**/.obsidian/workspace.json
obsidian/**/.obsidian/workspace-mobile.json

# ─── Backup archives ──────────────────────────────────────────────────────────
*.zip
*.tar.gz
backups/

# ─── Generated / temporary ────────────────────────────────────────────────────
*.tmp
*.temp
scratch/
